---
const base = import.meta.env.BASE_URL;
---
<div id="cmd-palette" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-label="搜索与命令" data-base={base}>
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-cmd-close></div>
  <div class="absolute top-[18%] left-1/2 -translate-x-1/2 w-[min(600px,92vw)]">
    <div class="card overflow-hidden shadow-xl">
      <div class="flex items-center gap-2.5 px-4 py-3 border-b border-border-light dark:border-border-dark">
        <svg class="w-4 h-4 text-text-light dark:text-text-dark shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        <input id="cmd-input" type="text" placeholder="搜索文章、笔记，或输入命令（> 开头）" class="flex-1 bg-transparent text-sm text-heading-light dark:text-heading-dark placeholder:text-text-light/70 dark:placeholder:text-text-dark/70" autocomplete="off" spellcheck="false" />
        <kbd class="px-1.5 py-0.5 text-[10px] font-medium rounded border border-border-light dark:border-border-dark text-text-light dark:text-text-dark shrink-0">Esc</kbd>
      </div>
      <ul id="cmd-results" class="max-h-[22rem] overflow-y-auto p-2"></ul>
    </div>
  </div>
</div>
<script>
  import MiniSearch from 'minisearch';

  const commands = [
    { title: '浏览 Archive', hint: '归档', icon: '⌘', run: () => { location.href = `${base}archive`; } },
    { title: '浏览 Tags', hint: '标签', icon: '⌘', run: () => { location.href = `${base}tags/`; } },
    { title: '浏览 Notes', hint: '学习笔记', icon: '⌘', run: () => { location.href = `${base}notes`; } },
    { title: '查看 About', hint: '关于', icon: '⌘', run: () => { location.href = `${base}about`; } },
    { title: '随机文章', hint: 'random', icon: '🎲', run: async () => { await getSearch(); if (docs.length) location.href = docs[Math.floor(Math.random() * docs.length)].url; } },
    { title: '切换主题', hint: 'dark / light', icon: '🌙', run: () => { document.getElementById('theme-toggle')?.click(); } },
    { title: 'GitHub', hint: 'github.com/xiaobin118', icon: '⌘', run: () => { window.open('https://github.com/xiaobin118', '_blank'); } },
  ];

  interface SearchDoc {
    title: string;
    description: string;
    tags: string[];
    type: string;
    topic: string;
    date: string;
    url: string;
  }

  const base = document.getElementById('cmd-palette')?.dataset.base ?? '';
  let search: MiniSearch | null = null;
  let docs: SearchDoc[] = [];
  let items: { title: string; sub?: string; hint?: string; icon: string; run?: () => void }[] = [];
  let activeIndex = 0;

  async function getSearch() {
    if (search) return search;
    try {
      const res = await fetch(`${base}search-index.json`);
      docs = await res.json();
      search = new MiniSearch({
        fields: ['title', 'tags', 'description', 'body'],
        storeFields: ['title', 'description', 'tags', 'url', 'type'],
        searchOptions: { boost: { title: 4, tags: 3 }, prefix: true, fuzzy: 0.2 },
      });
      search.addAll(docs);
    } catch {
      docs = [];
    }
    return search;
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function escapeRegExp(s: string) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }
  function highlight(text: string, q: string) {
    let out = escapeHtml(text);
    for (const t of q.split(/\s+/).filter(Boolean)) {
      out = out.replace(new RegExp(`(${escapeRegExp(t)})`, 'ig'), '<mark class="bg-accent-light/20 dark:bg-accent-dark/25 text-accent-light dark:text-accent-dark rounded px-0.5">$1</mark>');
    }
    return out;
  }

  function open() {
    const palette = document.getElementById('cmd-palette');
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    if (!palette || !input) return;
    palette.classList.remove('hidden');
    input.value = '';
    render(commands.map((c) => ({ ...c })));
    requestAnimationFrame(() => input.focus());
  }
  function close() {
    document.getElementById('cmd-palette')?.classList.add('hidden');
  }
  function isOpen() {
    return !document.getElementById('cmd-palette')?.classList.contains('hidden');
  }

  function render(list: typeof items) {
    const resultsEl = document.getElementById('cmd-results');
    if (!resultsEl) return;
    items = list;
    activeIndex = 0;
    if (!items.length) {
      resultsEl.innerHTML = '<li class="px-3 py-4 text-sm text-text-light dark:text-text-dark">没有匹配的结果</li>';
      return;
    }
    resultsEl.innerHTML = items
      .map(
        (item, i) => `
      <li>
        <button type="button" data-idx="${i}" class="w-full text-left px-3 py-2.5 rounded-xl flex items-center gap-3 transition-colors ${i === 0 ? 'bg-bg-light/70 dark:bg-bg-dark/70' : 'hover:bg-bg-light/60 dark:hover:bg-bg-dark/60'}">
          <span class="w-8 h-8 shrink-0 rounded-full bg-accent-light/15 dark:bg-accent-dark/15 text-accent-light dark:text-accent-dark flex items-center justify-center text-xs">${item.icon}</span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-heading-light dark:text-heading-dark truncate">${item.title}</span>
            ${item.sub ? `<span class="block text-xs text-text-light dark:text-text-dark truncate">${item.sub}</span>` : ''}
          </span>
          ${item.hint ? `<span class="text-xs text-text-light dark:text-text-dark shrink-0">${escapeHtml(item.hint)}</span>` : ''}
        </button>
      </li>`
      )
      .join('');
  }

  function move(d: number) {
    const resultsEl = document.getElementById('cmd-results');
    if (!resultsEl || !items.length) return;
    activeIndex = (activeIndex + d + items.length) % items.length;
    [...resultsEl.querySelectorAll('button[data-idx]')].forEach((btn, i) => {
      const el = btn as HTMLElement;
      el.classList.toggle('bg-bg-light/70', i === activeIndex);
      el.classList.toggle('dark:bg-bg-dark/70', i === activeIndex);
    });
  }

  function select() {
    items[activeIndex]?.run?.();
  }

  async function updateResults() {
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    const q = input?.value.trim() ?? '';
    const isCommand = q.startsWith('>');
    const term = (isCommand ? q.slice(1) : q).trim().toLowerCase();

    const cmdItems = commands
      .filter((c) => !term || `${c.title} ${c.hint}`.toLowerCase().includes(term))
      .map((c) => ({ ...c }));

    let postItems: typeof items = [];
    if (q && !isCommand) {
      const s = await getSearch();
      if (s) {
        postItems = (s.search(q, { combineWith: 'AND' }) as unknown as Partial<SearchDoc>[])
          .slice(0, 6)
          .map((r) => ({
            title: highlight(r.title ?? '', q),
            sub: escapeHtml(r.description || (r.tags ?? []).join(' · ')),
            icon: r.type === 'note' ? '📝' : '📄',
            run: () => { location.href = r.url ?? ''; },
          }));
      }
    } else if (!q) {
      const s = await getSearch();
      if (s && docs.length) {
        postItems = docs
          .slice()
          .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
          .slice(0, 5)
          .map((r) => ({
            title: escapeHtml(r.title),
            sub: escapeHtml(r.description || r.tags.join(' · ')),
            icon: r.type === 'note' ? '📝' : '📄',
            run: () => { location.href = r.url; },
          }));
      }
    }

    render(isCommand ? cmdItems : [...cmdItems, ...postItems]);
  }

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const mod = e.ctrlKey || e.metaKey;
    if (mod && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
    } else if (e.key === 'Escape' && isOpen()) {
      close();
    } else if (isOpen()) {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') { e.preventDefault(); select(); }
    }
  });

  document.addEventListener('input', (e: Event) => {
    if ((e.target as HTMLElement | null)?.closest('#cmd-input')) updateResults();
  });

  document.addEventListener('click', (e: Event) => {
    const t = e.target as HTMLElement | null;
    if (t?.closest('#cmd-trigger')) { open(); return; }
    if (t?.closest('[data-cmd-close]')) { close(); return; }
    const btn = t?.closest('#cmd-results button[data-idx]');
    if (btn) items[Number((btn as HTMLElement).getAttribute('data-idx'))]?.run?.();
  });
</script>
