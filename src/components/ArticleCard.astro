---
import type { CollectionEntry } from 'astro:content';
import { slugifyTag } from '../lib/tags';
import { estimateReadTime } from '../lib/reading';

interface Props {
  post: CollectionEntry<'blog'>;
  delay?: number;
}
const { post, delay = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const minutes = estimateReadTime(post.body ?? '');
---
<a
  href={`${base}post/${post.id}/`}
  class="card p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group"
  data-reveal
  style={`transition-delay: ${delay}ms`}
>
  <div class="flex items-start justify-between gap-4 mb-2">
    <h2 class="text-lg font-semibold text-heading-light dark:text-heading-dark group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors">{post.data.title}</h2>
    <time datetime={post.data.date.toISOString()} class="text-sm text-text-light dark:text-text-dark shrink-0">{post.data.date.toLocaleDateString('zh-CN')}</time>
  </div>
  {post.data.description && (
    <p class="text-sm text-text-light dark:text-text-dark line-clamp-2">{post.data.description}</p>
  )}
  <div class="flex items-center justify-between gap-3 mt-4 pt-3 border-t border-border-light dark:border-border-dark flex-wrap">
    <div class="flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <a href={`${base}tags/${slugifyTag(tag)}/`} class="tag">{tag}</a>
      ))}
    </div>
    <span class="text-xs text-text-light dark:text-text-dark shrink-0">{minutes} min read</span>
  </div>
</a>
