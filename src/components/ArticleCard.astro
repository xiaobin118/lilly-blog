---
import type { CollectionEntry } from 'astro:content';
import { slugifyTag } from '../lib/tags';
import { estimateReadTime } from '../lib/reading';

interface Props {
  post: CollectionEntry<'blog'>;
  delay?: number;
}
const { post, delay = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const minutes = estimateReadTime(post.body ?? '');
const postUrl = `${base}post/${post.id}/`;
---
<div
  class="card p-6 relative hover:shadow-lg hover:-translate-y-1 transition-[transform,box-shadow] duration-normal ease-out group"
  data-reveal
  data-search-item
  style={`transition-delay: ${delay}ms`}
>
  <div class="flex items-start justify-between gap-4 mb-2">
    <h2 class="text-lg font-semibold text-heading-light dark:text-heading-dark group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors">
      <a href={postUrl} class="stretched-link">{post.data.title}</a>
    </h2>
    <time datetime={post.data.date.toISOString()} class="text-sm text-text-light dark:text-text-dark shrink-0">{post.data.date.toLocaleDateString('zh-CN')}</time>
  </div>
  {post.data.description && (
    <p class="text-sm text-text-light dark:text-text-dark line-clamp-2">{post.data.description}</p>
  )}
  <div class="flex items-center justify-between gap-3 mt-4 flex-wrap">
    <div class="flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <a href={`${base}tags/${slugifyTag(tag)}/`} class="tag relative">{tag}</a>
      ))}
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-xs text-text-light dark:text-text-dark">{minutes} min read</span>
      <span class="text-sm text-text-light dark:text-text-dark group-hover:text-accent-light dark:group-hover:text-accent-dark group-hover:translate-x-0.5 transition-[transform,color] duration-fast ease-out" aria-hidden="true">→</span>
    </div>
  </div>
</div>
