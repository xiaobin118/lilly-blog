---
const { section } = Astro.props;
const id = `panel-${section.id}`;
---
<div class="card overflow-hidden transition-colors duration-300 hover:shadow-lg" data-reveal>
  <button
    data-collapsible={section.id}
    aria-expanded="true"
    aria-controls={id}
    class="w-full flex items-center justify-between p-5 cursor-pointer hover:bg-bg-light/50 dark:hover:bg-bg-dark/50 transition-colors"
  >
    <span class="flex items-center gap-3">
      <span class="text-2xl">{section.icon}</span>
      <span class="text-lg font-bold text-heading-light dark:text-heading-dark">{section.title}</span>
      <span class="text-sm text-text-light dark:text-text-dark">({section.items.length})</span>
    </span>
    <svg class="chevron text-text-light dark:text-text-dark transition-transform duration-300" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <div id={id} class="px-5 pb-5 flex flex-col gap-2">
    {
      section.items.map((item) => (
        <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-bg-light/50 dark:hover:bg-bg-dark/50 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-light dark:bg-accent-dark mt-2 shrink-0" />
          <div>
            <p class="text-sm font-medium text-heading-light dark:text-heading-dark">{item.title}</p>
            <p class="text-xs text-text-light dark:text-text-dark mt-0.5">{item.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
<script>
  // Event delegation: survives ClientRouter view transitions, which swap the
  // DOM after the first visit and leave direct listeners attached to dead nodes.
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-collapsible]');
    if (!btn) return;
    const panel = document.getElementById(btn.getAttribute('aria-controls'));
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    panel.hidden = expanded;
    const chevron = btn.querySelector('.chevron');
    if (chevron) chevron.style.transform = expanded ? 'rotate(0deg)' : 'rotate(180deg)';
  });
</script>
