---
const base = import.meta.env.BASE_URL;

// Match the full-stack blog's per-page background pools.
const homeImages = [
  `${base}image/home/woman_with_a_parasol_-_madame_monet_and_her_son_1983.1.29.webp`,
  `${base}image/home/普维尔悬崖漫步.webp`,
  `${base}image/home/153-莫奈- Bend in the Epte River near Giverny.webp`,
];
const achieveImages = [
  `${base}image/achieve/1.webp`,
  `${base}image/achieve/13.webp`,
];
const aboutImages = [
  `${base}image/about/AD House12.webp`,
  `${base}image/about/AD PainoX.webp`,
  `${base}image/about/AD PianoIX.webp`,
  `${base}image/about/AD PiaonIV.webp`,
  `${base}image/about/Qualia.webp`,
  `${base}image/about/work.webp`,
];

// Astro generates trailing-slash URLs (/lilly-blog/archive/), so strip the
// base and trailing slash before matching the page.
const clean = Astro.url.pathname.replace(new RegExp(`^${base}`), '').replace(/\/$/, '');
let pool: string[];
if (clean === 'about') {
  pool = aboutImages;
} else if (clean === 'archive') {
  pool = achieveImages;
} else {
  pool = homeImages;
}
const bg = pool[Math.floor(Math.random() * pool.length)];
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-bg-light dark:bg-bg-dark" />
  <img src={bg} alt="" class="absolute inset-0 w-full h-full object-cover opacity-40 dark:opacity-30" />
</div>
