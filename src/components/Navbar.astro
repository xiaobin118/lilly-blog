---
const base = import.meta.env.BASE_URL;
const navItems = [
  { href: base, label: 'Home' },
  { href: `${base}archive`, label: 'Archive' },
  { href: `${base}tags/`, label: 'Tags' },
  { href: `${base}about`, label: 'About' },
  { href: 'https://github.com/xiaobin118', label: 'GitHub', external: true },
];

const current = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '');
  if (href === base) return current === target;
  return current === target || current.startsWith(target + '/');
};
---
<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-bg-light/80 dark:bg-bg-dark/80 border-b border-border-light dark:border-border-dark">
  <div class="max-w-6xl mx-auto px-3 sm:px-4 h-16 flex items-center justify-between">
    <a href={base} class="text-base sm:text-lg font-bold text-heading-light dark:text-heading-dark">Lilly</a>
    <div class="flex items-center gap-3 sm:gap-4">
      {
        navItems.map((item) => {
          const active = !item.external && isActive(item.href);
          const cls = `text-sm transition-colors ${
            active
              ? 'text-heading-light dark:text-heading-dark font-medium underline decoration-accent-light dark:decoration-accent-dark decoration-2 underline-offset-8'
              : 'text-text-light dark:text-text-dark hover:text-heading-light dark:hover:text-heading-dark'
          }`;
          return item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class={cls}>{item.label}</a>
          ) : (
            <a href={item.href} class={cls} aria-current={active ? 'page' : undefined}>{item.label}</a>
          );
        })
      }
      <button id="theme-toggle" aria-label="Toggle theme" class="p-2 rounded-full text-text-light dark:text-text-dark hover:bg-card-light dark:hover:bg-card-dark transition-colors cursor-pointer">
        <span id="theme-icon">🌙</span>
      </button>
    </div>
  </div>
</nav>
<script>
  // Event delegation: survives ClientRouter view transitions, which swap the
  // DOM after the first load and leave direct listeners attached to dead nodes.
  function syncIcon() {
    const icon = document.getElementById('theme-icon');
    if (icon) icon.textContent = document.documentElement.classList.contains('dark') ? '☀️' : '🌙';
  }
  syncIcon();
  // View transitions swap the navbar DOM, so re-sync the icon to the actual
  // theme after every page load (the theme class is re-applied by BaseLayout).
  document.addEventListener('astro:page-load', syncIcon);
  document.addEventListener('click', (e: Event) => {
    const target = e.target as Element | null;
    if (!target?.closest('#theme-toggle')) return;
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    syncIcon();
  });
</script>
