---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog'))
  .filter((post) => post.data.project === project.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const statusLabel = { done: '已完成', doing: '进行中', planned: '规划中' }[project.data.status];
---
<BaseLayout title={`${project.data.title} | Lilly's Blog`} description={project.data.description}>
  <div class="page">
    <a href={`${base}projects/`} class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-light dark:text-accent-dark hover:text-heading-light dark:hover:text-heading-dark transition-colors mb-6 group">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
      返回项目列表
    </a>

    <article class="card p-8 md:p-12">
      <header class="mb-8 pb-6 border-b border-border-light dark:border-border-dark">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <h1 class="text-3xl md:text-4xl font-bold text-heading-light dark:text-heading-dark">{project.data.title}</h1>
          <span class={`tag tag-${project.data.status}`}>{statusLabel}</span>
        </div>
        <div class="flex items-center gap-4 mt-4 flex-wrap">
          <time datetime={project.data.date.toISOString()} class="text-sm text-text-light dark:text-text-dark">
            {project.data.date.toLocaleDateString('zh-CN')}
          </time>
          {project.data.tech.map((item) => <span class="tag">{item}</span>)}
          {project.data.repo && (
            <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="text-sm text-accent-light dark:text-accent-dark hover:underline">仓库 →</a>
          )}
        </div>
      </header>
      <div class="prose prose-lg max-w-none dark:prose-invert">
        <Content />
      </div>
    </article>

    <section class="mt-8">
      <h2 class="section-title mb-4">项目文章</h2>
      {
        posts.length > 0 ? (
          <div class="flex flex-col gap-5">
            {posts.map((post, i) => <ArticleCard post={post} delay={Math.min(i * 25, 75)} />)}
          </div>
        ) : (
          <div class="card p-8 text-center">
            <p class="text-sm text-text-light dark:text-text-dark">这个项目还没有关联文章。</p>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
