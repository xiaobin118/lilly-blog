---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugifyTag } from '../../lib/tags';
import { estimateReadTime } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
const toc = headings.filter((h) => h.depth >= 2);
const readMinutes = estimateReadTime(post.body ?? '');
// Related posts: share at least one tag, ranked by overlap then recency.
const related = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, overlap: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .filter((x) => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((x) => x.p);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: { '@type': 'Person', name: 'Lilly' },
      keywords: post.data.tags.join(', '),
      url: new URL(Astro.url.pathname, Astro.site).href,
    })}
  />
  <div class="page">
    <div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-accent-light dark:bg-accent-dark z-[60] w-0" aria-hidden="true"></div>
    <a href={base} class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-light dark:text-accent-dark hover:text-heading-light dark:hover:text-heading-dark transition-colors mb-6 group">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
      返回文章列表
    </a>
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-6 lg:gap-8 items-start">
      <div class="min-w-0">
        {
          toc.length > 0 && (
            <details class="card p-4 mb-6 lg:hidden" open>
              <summary class="text-sm font-semibold text-heading-light dark:text-heading-dark cursor-pointer select-none">On this page</summary>
              <nav class="mt-3 flex flex-col gap-1.5 text-sm">
                {
                  toc.map((h) => (
                    <a
                      href={`#${h.slug}`}
                      class="toc-link text-text-light dark:text-text-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors"
                      style={`padding-left: ${(h.depth - 2) * 12}px`}
                    >{h.text}</a>
                  ))
                }
              </nav>
            </details>
          )
        }
        <article class="card p-8 md:p-12">
          <header class="mb-8 pb-6 border-b border-border-light dark:border-border-dark">
            <h1 class="text-3xl md:text-4xl font-bold text-heading-light dark:text-heading-dark">{post.data.title}</h1>
            <div class="flex items-center gap-4 mt-4 flex-wrap">
              <time datetime={post.data.date.toISOString()} class="text-sm text-text-light dark:text-text-dark">{post.data.date.toLocaleDateString('zh-CN')}</time>
              <span class="text-sm text-text-light dark:text-text-dark">· {readMinutes} min read</span>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <a href={`${base}tags/${slugifyTag(tag)}/`} class="tag">{tag}</a>
                ))}
              </div>
            </div>
          </header>
          <div class="prose prose-lg max-w-none dark:prose-invert">
            <Content />
          </div>
        </article>
        {
          related.length > 0 && (
            <section class="mt-8">
              <h2 class="text-xl font-bold text-heading-light dark:text-heading-dark mb-4">相关文章</h2>
              <div class="flex flex-col gap-3">
                {
                  related.map((p) => (
                    <a href={`${base}post/${p.id}/`} class="card p-4 hover:shadow-md transition-shadow duration-300 block group">
                      <div class="flex items-start justify-between gap-3">
                        <h3 class="text-base font-medium text-heading-light dark:text-heading-dark group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors">{p.data.title}</h3>
                        <time datetime={p.data.date.toISOString()} class="text-xs text-text-light dark:text-text-dark shrink-0">{p.data.date.toLocaleDateString('zh-CN')}</time>
                      </div>
                      <div class="flex flex-wrap gap-1.5 mt-2">
                        {p.data.tags.map((tag) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    </a>
                  ))
                }
              </div>
            </section>
          )
        }
      </div>
      {
        toc.length > 0 && (
          <aside class="hidden lg:block sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-1">
            <nav class="card p-4">
              <h2 class="text-sm font-semibold text-heading-light dark:text-heading-dark">On this page</h2>
              <div class="mt-3 flex flex-col gap-1.5 text-sm">
                {
                  toc.map((h) => (
                    <a
                      href={`#${h.slug}`}
                      class="toc-link text-text-light dark:text-text-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors"
                      style={`padding-left: ${(h.depth - 2) * 12}px`}
                    >{h.text}</a>
                  ))
                }
              </div>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
<script>
  // Reading progress bar + TOC active-section highlight. Re-inits after every
  // ClientRouter navigation (astro:page-load) but binds scroll/resize once.
  let readingBound = false;
  function initReading() {
    const bar = document.getElementById('reading-progress');
    const links = [...document.querySelectorAll('.toc-link')];
    const headings = links
      .map((a) => document.getElementById(a.getAttribute('href')?.slice(1) ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    if (!bar && links.length === 0) return;

    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const p = max > 0 ? window.scrollY / max : 0;
      if (bar) bar.style.width = `${(p * 100).toFixed(1)}%`;
      let active = headings[0];
      for (const h of headings) if (h.getBoundingClientRect().top <= 96) active = h;
      for (const a of links) a.classList.toggle('toc-active', a.getAttribute('href') === `#${active?.id}`);
    };

    if (!readingBound) {
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      readingBound = true;
    }
    update();
  }
  initReading();
  document.addEventListener('astro:page-load', initReading);
</script>
