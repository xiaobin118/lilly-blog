---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="Lilly's Blog">
  <div class="page">
    <section class="mb-10">
      <h1 class="text-3xl font-bold text-heading-light dark:text-heading-dark">Hi there, I'm a programmer from HIT.</h1>
      <p class="mt-2 text-text-light dark:text-text-dark">I love music and anime, hope you can find something interesting here!</p>
    </section>
    <section class="flex flex-col gap-5">
      {posts.map((post, i) => <ArticleCard post={post} delay={i * 80} />)}
    </section>
  </div>
</BaseLayout>
