---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { slugifyTag } from '../lib/tags';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}
const yearGroups = Array.from(byYear.entries()).sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="Archive | Lilly's Blog">
  <div class="relative max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-heading-light dark:text-heading-dark mb-8">Archive</h1>
    <div class="flex flex-col gap-8">
      {
        yearGroups.map(([year, entries]) => (
          <section>
            {/* Year header */}
            <div class="flex items-center gap-4 mb-4">
              <h2 class="text-2xl font-bold text-heading-light dark:text-heading-dark">{year}</h2>
              <div class="flex-1 h-px bg-border-light dark:border-border-dark" />
              <span class="text-sm text-text-light dark:text-text-dark">{entries.length} articles</span>
            </div>

            {/* Timeline entries */}
            <div class="relative pl-6 border-l-2 border-border-light dark:border-border-dark">
              <div class="flex flex-col gap-4">
                {entries.map((entry, i) => (
                  <div class="relative group" data-reveal style={`transition-delay: ${i * 60}ms`}>
                    {/* Dot on timeline */}
                    <div class="absolute -left-[31px] top-3 w-3 h-3 rounded-full bg-accent-light dark:bg-accent-dark border-2 border-card-light dark:border-card-dark" />
                    <a href={`${base}post/${entry.id}`} class="card p-4 hover:shadow-md transition-shadow duration-300 block">
                      <div class="flex items-start justify-between gap-3 mb-2">
                        <h3 class="text-base font-medium text-heading-light dark:text-heading-dark group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors">{entry.data.title}</h3>
                        <time datetime={entry.data.date.toISOString()} class="text-xs text-text-light dark:text-text-dark shrink-0">{entry.data.date.toLocaleDateString('zh-CN')}</time>
                      </div>
                      <div class="flex flex-wrap gap-1.5">
                        {entry.data.tags.map((tag) => (
                          <a href={`${base}tags/${slugifyTag(tag)}/`} class="px-2 py-0.5 text-xs rounded-full bg-accent-light/10 dark:bg-accent-dark/10 text-accent-light dark:text-accent-dark hover:bg-accent-light/20 dark:hover:bg-accent-dark/20 transition-colors">{tag}</a>
                        ))}
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
