---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Lilly's Blog" } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og-image.webp`, Astro.site).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lilly's Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="Lilly's Blog" href={`${base}rss.xml`} />
    <ClientRouter />
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>
    <script is:inline>
      (function () {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          const dark = stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        }
        applyTheme();
        // View transitions replace <html> attributes (dropping the .dark class),
        // and the inline script is not re-run on navigation, so re-apply the theme
        // after every ClientRouter page load.
        document.addEventListener('astro:page-load', applyTheme);
      })();
    </script>
  </head>
  <body class="relative">
    <a href="#main" class="skip-link">跳到正文</a>
    <Background />
    <Navbar />
    <main id="main" class="site-main relative z-10 min-h-svh pt-16">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>
<script>
  // Content entrance. `[data-reveal]` starts hidden (see global.css) and is
  // revealed by IntersectionObserver on the FIRST full load (scroll-reveal).
  // On in-site navigation we materialize all pieces with a stagger instead —
  // the new root snapshot stays empty (no monolithic block swap) while the
  // background crossfades and the content paints in piecewise.
  function initReveal() {
    const els = document.querySelectorAll('[data-reveal]:not(.reveal-visible)');
    if (!els.length) return;
    // Fallback: never leave content invisible if IO is unavailable.
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
  let isFirstLoad = true;
  document.addEventListener('astro:page-load', () => {
    if (isFirstLoad) {
      initReveal();
      isFirstLoad = false;
    } else {
      // Navigation: phase the entrance AFTER the old content has faded out
      // (base delay = --vt-content-out) and stagger by DOM order so visual
      // anchors (page title) land before the cards below. transitionDelay is
      // restored afterwards so hover transitions stay instant.
      const els = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const baseMs =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--vt-content-out')) || 160;
      els.forEach((el, i) => {
        el.style.transitionDelay = `${baseMs + Math.min(i, 8) * 20}ms`;
        el.classList.add('reveal-visible');
      });
      setTimeout(() => els.forEach((el) => { el.style.transitionDelay = ''; }), 800);
    }
  });
  initReveal();

  async function copyText(text: string) {
    try {
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
      else throw new Error('no clipboard');
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
  }

  // Add copy button + language label to every Shiki code block. Re-runs on
  // astro:page-load for newly swapped-in code. The button/label are placed in
  // a wrapper around the <pre> (siblings of the scrollable pre) so they stay
  // fixed when the code scrolls horizontally.
  function initCodeBlocks() {
    document.querySelectorAll<HTMLElement>('pre.astro-code').forEach((pre) => {
      if (pre.dataset.enhanced) return;
      pre.dataset.enhanced = '1';
      pre.classList.add('code-enhanced');

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.parentNode!.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const code = pre.querySelector('code');
      const lang = pre.getAttribute('data-language');
      if (lang) {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrapper.appendChild(label);
      }
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy';
      copyBtn.setAttribute('aria-label', 'Copy code');
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        const lines = code
          ? [...code.querySelectorAll('.line')].map((l) => l.textContent).join('\n')
          : '';
        if (!lines) return;
        await copyText(lines);
        copyBtn.textContent = 'Copied';
        setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
      });
      wrapper.appendChild(copyBtn);
    });
  }
  initCodeBlocks();
  document.addEventListener('astro:page-load', initCodeBlocks);

  // Skip link. The jump target has to be focusable or screen readers keep
  // their cursor on the link, but a static `tabindex="-1"` on <main> trips
  // a11y linters that flag tabindex on non-interactive elements. Adding the
  // attribute only when the link is actually used keeps both behaviours.
  // Delegated: the skip link is re-created on every ClientRouter navigation.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest('.skip-link');
    if (!link) return;
    const main = document.getElementById('main');
    if (!main) return;
    main.setAttribute('tabindex', '-1');
    main.focus({ preventScroll: true });
  });
</script>
